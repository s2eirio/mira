{
  "project": {
    "name": "Mira",
    "version": "1.0.0",
    "description": "Vibe Coding Agent System",
    "author": "s2eirio",
    "license": "MIT"
  },
  "agents": {
    "orchestrator": {
      "enabled": true,
      "maxIterations": 50,
      "timeout": 300000
    },
    "design": {
      "enabled": true,
      "defaultTheme": "default"
    },
    "dev": {
      "enabled": true,
      "framework": "react",
      "lintOnGenerate": true
    },
    "qa": {
      "enabled": true,
      "visualRegression": true,
      "headless": true
    },
    "ops": {
      "enabled": true,
      "branchStrategy": "gitflow",
      "autoDeploy": false
    },
    "platform": {
      "enabled": true,
      "defaultPlatform": "web"
    }
  },
  "skills": {
    "executionMode": "sequential",
    "parallelLimit": 5
  },
  "knowledge": {
    "domainRules": [],
    "customRules": []
  }
}
