{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test Case",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^TC-\\d{3}$" },
    "category": { "type": "string", "enum": ["happy", "unhappy", "edge", "ui"] },
    "given": { "type": "string" },
    "when": { "type": "string" },
    "then": { "type": "string" },
    "dataTestId": { "type": "string" },
    "expectedValue": { "type": ["string", "number", "boolean"] },
    "priority": { "type": "string", "enum": ["high", "medium", "low"] },
    "status": { "type": "string", "enum": ["pending", "pass", "fail", "skipped"] }
  },
  "required": ["id", "given", "when", "then", "priority"]
}
