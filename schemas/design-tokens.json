{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Tokens",
  "type": "object",
  "properties": {
    "colors": {
      "type": "object",
      "properties": {
        "primary": { "type": "string", "format": "hex-color" },
        "primaryLight": { "type": "string", "format": "hex-color" },
        "primaryDark": { "type": "string", "format": "hex-color" },
        "secondary": { "type": "string", "format": "hex-color" },
        "background": { "type": "string", "format": "hex-color" },
        "surface": { "type": "string", "format": "hex-color" },
        "text": { "type": "string", "format": "hex-color" },
        "textSecondary": { "type": "string", "format": "hex-color" },
        "border": { "type": "string", "format": "hex-color" },
        "success": { "type": "string", "format": "hex-color" },
        "warning": { "type": "string", "format": "hex-color" },
        "error": { "type": "string", "format": "hex-color" }
      },
      "required": ["primary", "background", "text"]
    },
    "spacing": {
      "type": "object",
      "properties": {
        "base": { "type": "string" },
        "xs": { "type": "string" },
        "sm": { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "xl": { "type": "string" },
        "2xl": { "type": "string" }
      },
      "required": ["base"]
    },
    "typography": {
      "type": "object",
      "properties": {
        "family": { "type": "string" },
        "heading": { "type": "string" },
        "body": { "type": "string" },
        "caption": { "type": "string" },
        "mono": { "type": "string" },
        "weight": {
          "type": "object",
          "properties": {
            "light": { "type": "number" },
            "normal": { "type": "number" },
            "medium": { "type": "number" },
            "bold": { "type": "number" }
          }
        }
      },
      "required": ["family", "heading", "body"]
    },
    "radius": {
      "type": "object",
      "properties": {
        "sm": { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "xl": { "type": "string" },
        "full": { "type": "string" }
      },
      "required": ["md"]
    },
    "shadow": {
      "type": "object",
      "properties": {
        "sm": { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "xl": { "type": "string" }
      },
      "required": ["md"]
    }
  },
  "required": ["colors", "spacing", "typography", "radius"]
}
